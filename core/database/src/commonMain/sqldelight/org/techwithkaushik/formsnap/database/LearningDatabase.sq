CREATE TABLE UserCorrectionLog (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    contentType TEXT NOT NULL,
    detectedX INTEGER NOT NULL,
    detectedY INTEGER NOT NULL,
    correctedX INTEGER NOT NULL,
    correctedY INTEGER NOT NULL,
    isRejected INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE TunedParameters (
    parameterKey TEXT NOT NULL PRIMARY KEY,
    parameterValue REAL NOT NULL
);

selectAllLogs:
SELECT * FROM UserCorrectionLog;

selectAllParameters:
SELECT * FROM TunedParameters;

insertCorrection:
INSERT INTO UserCorrectionLog(
    timestamp,
    contentType,
    detectedX,
    detectedY,
    correctedX,
    correctedY,
    isRejected
)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateParameter:
INSERT OR REPLACE INTO TunedParameters(parameterKey, parameterValue)
VALUES (?, ?);

getParameter:
SELECT parameterValue
FROM TunedParameters
WHERE parameterKey = ?;

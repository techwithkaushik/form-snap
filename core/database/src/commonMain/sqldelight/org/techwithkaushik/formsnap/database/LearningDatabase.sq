CREATE TABLE UserCorrectionLog (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    timestamp INTEGER NOT NULL,
    contentType TEXT NOT NULL,
    detectedX INTEGER NOT NULL,
    detectedY INTEGER NOT NULL,
    correctedX INTEGER NOT NULL,
    correctedY INTEGER NOT NULL,
    isRejected INTEGER AS Boolean NOT NULL DEFAULT 0
);

CREATE TABLE TunedParameters (
    kind TEXT NOT NULL,
    contextKey TEXT NOT NULL,
    actionIndex INTEGER NOT NULL,
    visits INTEGER NOT NULL DEFAULT 0,
    totalReward REAL NOT NULL DEFAULT 0.0,
    lastReward REAL NOT NULL DEFAULT 0.0,
    updatedAt INTEGER NOT NULL,
    PRIMARY KEY (kind, contextKey, actionIndex)
);

insertLog:
INSERT INTO UserCorrectionLog (
    timestamp,
    contentType,
    detectedX,
    detectedY,
    correctedX,
    correctedY,
    isRejected
) VALUES (
    :timestamp,
    :contentType,
    :detectedX,
    :detectedY,
    :correctedX,
    :correctedY,
    :isRejected
);

insertParameter:
INSERT OR REPLACE INTO TunedParameters (
    kind,
    contextKey,
    actionIndex,
    visits,
    totalReward,
    lastReward,
    updatedAt
) VALUES (
    :kind,
    :contextKey,
    :actionIndex,
    :visits,
    :totalReward,
    :lastReward,
    :updatedAt
);

selectAllLogs:
SELECT
    id,
    timestamp,
    contentType,
    detectedX,
    detectedY,
    correctedX,
    correctedY,
    isRejected
FROM UserCorrectionLog
ORDER BY id;

selectAllParameters:
SELECT
    kind,
    contextKey,
    actionIndex,
    visits,
    totalReward,
    lastReward,
    updatedAt
FROM TunedParameters
ORDER BY kind, contextKey, actionIndex;
